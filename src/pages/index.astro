---
import Layout from "@/layouts/Layout.astro";
import { Planner } from "@/components/planner/Planner";
import PlannerSkeleton from "@/components/planner/PlannerSkeleton.astro";
---

<Layout title="Critical Path">
  <main class="flex h-dvh flex-col">
    <noscript>
      <p class="border-b px-4 py-3 text-sm">
        Critical Path needs JavaScript to run the planner. Turn it on and reload the page.
      </p>
    </noscript>
    {/* client:only is the only permitted directive: server-rendered React Flow markup carries style attributes the CSP rejects. */}
    <Planner client:only="react">
      <PlannerSkeleton slot="fallback" />
    </Planner>
  </main>
</Layout>
